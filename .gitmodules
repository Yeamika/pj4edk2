[submodule "pj4edk2-uefi"]
	path = uefi/pj4edk2
	url = https://github.com/Yeamika/pj4edk2.git
	branch = uefi
[submodule "linux-small"]
	path = kernel/source
	url = https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
[submodule "pj4edk2-linux-boot-display"]
	path = initramfs/common
	url = https://github.com/Yeamika/pj4edk2.git
	branch = kernel-boot-display
[submodule "pj4edk2-linux-efi"]
	path = efi/common
	url = https://github.com/Yeamika/pj4edk2.git
	branch = linux-efi
